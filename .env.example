# ---- Server ----------------------------------------------------------------
# Absolute URL of the app (used in emailed links, and its host is the passkey
# domain: passkeys only work on this host). Defaults to the request host.
PUBLIC_URL=https://app.example.com

# First administrator. Created on start-up if no account with this email
# exists; an existing account with this email is promoted to admin. The
# password is only used on creation — change it later in the app.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Max upload size per file in MB.
MAX_UPLOAD_MB=100

# Host port (bound to 127.0.0.1) for local access: http://localhost:8080
PORT=8080

# Encrypts secrets stored in the database (the SMTP password set in the app).
# Optional: without it a random key is created at DATA_DIR/secret.key. Keep
# whichever you use; changing it means re-entering the SMTP password.
SECRET_KEY=

# ---- SMTP / email (optional) -------------------------------------------------
# When SMTP_HOST and SMTP_FROM are set, self sign-ups and email changes must be
# confirmed through an emailed link. Without SMTP they take effect immediately.
# Admins can also configure and test SMTP in the app (Admin → Email); settings
# saved there take precedence over these variables.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Anwesenheit

# ---- Branding (served to the browser at runtime) ---------------------------
# Defaults only: name, logo and accent color can be changed in the app
# (Admin → Branding), which takes precedence.
VITE_DEFAULT_LANGUAGE=de        # de | en
VITE_APP_NAME=Anwesenheit
VITE_ACCENT_COLOR=#efa100
