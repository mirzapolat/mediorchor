# ---- Frontend (Vite / browser) --------------------------------------------
# Supabase project the app talks to.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# UI defaults (overridable in-app via Settings).
VITE_DEFAULT_LANGUAGE=de        # de | en
VITE_APP_NAME=Anwesenheit
VITE_ACCENT_COLOR=#efa100

# Docker host port (docker-compose).
PORT=8080

# ---- SMTP / email ----------------------------------------------------------
# Configure these in your Supabase project's Auth → SMTP settings so that
# invites, password resets and email changes are delivered from your own server.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Anwesenheit
